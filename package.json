    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@parcel/config-default": "^2.16.0",
    "@playwright/test": "^1.56.1",
    "@axe-core/playwright": "^4.10.2",
    "@types/qrcode": "^1.5.5",
    "gh-pages": "^6.3.0",
    "html-inline": "^1.2.0",
    "jsqr": "^1.4.0",
    "oxlint": "^1.88.0",
    "parcel": "^2.16.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
